// backend/prisma/schema.prisma

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum ApplicationStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  ACTION_REQUIRED
}

model UnifiedApplication {
  id                  String               @id @default(uuid())
  businessName        String
  applicantId         String               // References Auth user ID in PostgreSQL
  overallStatus       ApplicationStatus    @default(PENDING)
  submittedAt         DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  
  // Stores the original, full unsplit JSON payload as audit trail
  rawPayload          Json

  // Relations to departmental queue tables
  fireQueue           FireDepartmentQueue?
  waterQueue          WaterDepartmentQueue?

  @@index([applicantId])
  @@index([overallStatus])
}

model FireDepartmentQueue {
  id                  String               @id @default(uuid())
  // Strict 1-to-1 relation to the master UnifiedApplication record
  applicationId       String               @unique
  application         UnifiedApplication   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  
  status              ApplicationStatus    @default(PENDING)
  
  // Specific data block extracted for the Fire Department (nozzles, fire safety plan, chemical storage, etc.)
  extractedData       Json
  
  reviewerRemarks     String?
  reviewedBy          String?
  reviewedAt          DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([status])
}

model WaterDepartmentQueue {
  id                  String               @id @default(uuid())
  // Strict 1-to-1 relation to the master UnifiedApplication record
  applicationId       String               @unique
  application         UnifiedApplication   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  
  status              ApplicationStatus    @default(PENDING)
  
  // Specific data block extracted for the Water Department (sewage disposal, daily supply load, pipeline blueprints)
  extractedData       Json
  
  reviewerRemarks     String?
  reviewedBy          String?
  reviewedAt          DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([status])
}
